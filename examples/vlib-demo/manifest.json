{
  "api": 1,
  "id": "alice.picks",
  "name": "示例片单",
  "version": "1.0.0",
  "min_mv_version": "3.13.0",
  "author": "alice",
  "description": "虚拟库片单示例：不联网，返回占位片名与年份，演示片单和类型筛选。",
  "capabilities": {
    "vlib": {
      "lists": [
        {"key": "classic", "name": "科幻经典", "media_type": "movie"},
        {"key": "mixed", "name": "混合片单", "media_type": "mixed",
         "params": [{"key": "kind", "label": "类型", "type": "select",
                     "options": [{"value": "all", "label": "全部"}, {"value": "movie", "label": "只要电影"}, {"value": "tv", "label": "只要剧集"}]}]}
      ]
    }
  }
}
