{
  "api": 1,
  "id": "alice.eventlog",
  "name": "示例事件记录",
  "version": "1.0.0",
  "author": "alice",
  "description": "Muvyo 事件示例：记录整理、订阅、下载的完成与失败，写进 Muvyo 日志并统计次数，不联网。",
  "permissions": {"domains": []},
  "config": [
    {"key": "keep", "label": "保留最近几条", "type": "number", "default": "20", "min": 1, "max": 100, "step": 1, "unit": "条"},
    {"key": "only_failed", "label": "只记录失败", "type": "bool", "default": "false", "help": "打开后忽略完成事件，只记录失败"}
  ],
  "capabilities": {
    "webhook": {"events": ["organize.completed", "organize.failed", "subscription.completed",
                           "download.completed", "download.failed"]}
  }
}
