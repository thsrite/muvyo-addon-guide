{
  "api": 1,
  "id": "alice.watchlog",
  "name": "示例观看记录",
  "version": "1.0.0",
  "author": "alice",
  "description": "Webhook 事件示例：记录媒体服务器发来的入库与看完事件，写进 Muvyo 日志并统计次数，不联网。",
  "permissions": {"domains": []},
  "config": [
    {"key": "keep", "label": "保留最近几条", "type": "number", "default": "20", "min": 1, "max": 100, "step": 1, "unit": "条"},
    {"key": "only_finished", "label": "只记录看完", "type": "bool", "default": "false", "help": "打开后忽略停止播放事件，只记录标为已看"}
  ],
  "capabilities": {
    "webhook": {"events": ["library.new", "playback.stop", "item.markplayed", "system.notificationtest"]}
  }
}
